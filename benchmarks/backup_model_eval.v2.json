    {
      "case_id": "grounding_stack_v2",
      "category": "grounded_answer",
      "prompt": "不要展示思考过程。只输出最终答案，且必须以“答案：”开头。只能依据证据回答，并在句末保留 [E1]。证据 [E1]：Stack = `Spring Boot + Vue`。问题：该方案使用什么技术栈？",
      "required_terms": [
        "Spring Boot",
        "Vue"
      ],
      "required_citations": [
        "[E1]"
      ],
      "forbidden_terms": [
        "React",
        "Django"
      ],
      "max_new_tokens": 220
    },
