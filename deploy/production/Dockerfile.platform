FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    AGENT_RUNS_ROOT=/data/product_runs \
    AGENT_PLATFORM_HOST=0.0.0.0 \
    AGENT_PLATFORM_PORT=8080

WORKDIR /app

RUN addgroup --system app && adduser --system --ingroup app app

COPY deploy/production/requirements-platform.txt /tmp/requirements-platform.txt
RUN pip install --no-cache-dir -r /tmp/requirements-platform.txt

COPY agent /app/agent
COPY README.md /app/README.md

RUN mkdir -p /data/product_runs && chown -R app:app /data /app
USER app

EXPOSE 8080

CMD ["gunicorn", "agent.platform.api:app", "-k", "uvicorn.workers.UvicornWorker", "--bind", "0.0.0.0:8080", "--workers", "2", "--timeout", "120", "--graceful-timeout", "30", "--keep-alive", "15"]
